# =================================================================
# CH1SA Workspace - Production Environment Variables Template
# =================================================================
# Salin file ini menjadi `.env` di root project:
# cp .env.example .env
# Kemudian isi nilai masing-masing variabel dengan data yang sesuai.
# JANGAN PERNAH commit file `.env` ke repository Git!
# =================================================================

# -----------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# -----------------------------------------------------------------
# Username untuk PostgreSQL
POSTGRES_USER=chisa

# Password kuat untuk database PostgreSQL (Wajib diganti!)
# Contoh: gunakan command `openssl rand -hex 16` untuk generate password acak
POSTGRES_PASSWORD=ganti_dengan_password_database_yang_kuat

# Nama database yang akan dibuat secara otomatis
POSTGRES_DB=chisa

# -----------------------------------------------------------------
# 2. Backend Security & JWT
# -----------------------------------------------------------------
# Secret key untuk menandatangani JWT token otentikasi (Wajib diisi & dirahasiakan!)
# Contoh: gunakan `openssl rand -hex 32`
JWT_SECRET=ganti_dengan_jwt_secret_acak_minimal_32_karakter

# Mode Gin: "release" untuk production, "debug" untuk development
GIN_MODE=release

# Otomatis menjalankan database seeder saat backend pertama kali start (true/false)
# Set true jika ingin user admin default (admin@chisa.local / Admin123!) langsung tersedia
AUTO_SEED=false

# -----------------------------------------------------------------
# 3. AI Assistant (NineRouter / OpenRouter)
# -----------------------------------------------------------------
# API Key NineRouter / OpenRouter (Wajib diisi untuk fitur chat assistant)
NINEROUTER_API_KEY=your_ninerouter_or_openrouter_api_key_here

# Base URL API LLM (Jika pakai container 9router internal: http://9router:20128/v1, atau OpenRouter: https://openrouter.ai/api/v1)
NINEROUTER_BASE_URL=http://9router:20128/v1

# Model AI yang digunakan (Contoh: my-combo, openai/gpt-4o-mini, anthropic/claude-3.5-haiku)
NINEROUTER_MODEL=my-combo

# Password awal untuk dashboard web UI container 9router
NINEROUTER_INITIAL_PASSWORD=admin123456

# -----------------------------------------------------------------
# 4. CORS & Frontend API Endpoint
# -----------------------------------------------------------------
# Daftar domain/origin yang diizinkan mengakses backend API (pisahkan dengan koma tanpa spasi)
# Saat production, ubah dengan domain Anda: https://app.domainanda.com,https://domainanda.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# URL endpoint backend yang diakses oleh browser klien frontend
# - Jika menggunakan Docker di VPS tanpa domain/reverse-proxy: http://IP_VPS:8080
# - Jika menggunakan reverse proxy / Nginx dengan domain: https://domainanda.com atau https://api.domainanda.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# -----------------------------------------------------------------
# 5. Host Port Mapping (Opsional, sesuaikan bila ada port konflik di VPS)
# -----------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

